@model IEnumerable<QuanLyCuaHangTheThao.Models.Scaffold.TblCaLamViec>
@{
    ViewData["Title"] = "Ca làm việc";
}
<div class="page-head">
    <div>
        <h1 class="page-title">Ca làm việc</h1>
        <div class="page-subtitle">Danh mục các ca trong ngày và khoảng giờ tương ứng</div>
    </div>
    <a class="btn btn-accent" asp-action="Create">+ Thêm ca</a>
</div>
@if (TempData["Success"] != null) { <div class="alert alert-success py-2">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger py-2">@TempData["Error"]</div> }

<div class="stat-strip">
    <div class="stat-card">
        <div class="stat-label">Tổng ca</div>
        <div class="stat-value">@ViewBag.TongCa</div>
        <div class="stat-caption">đang có</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Tổng lượt phân công</div>
        <div class="stat-value">@ViewBag.TongLuoc</div>
        <div class="stat-caption">ngày nhân viên</div>
    </div>
</div>

<div class="toolbar">
    <form method="get" class="toolbar-search">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" class="form-control form-control-fold" name="search" value="@ViewBag.Search" placeholder="Tìm tên ca..." />
    </form>
    <div class="pagination-info">
        @if (!string.IsNullOrWhiteSpace((string?)ViewBag.Search))
        {
            <span>Kết quả cho "<strong>@ViewBag.Search</strong>"</span>
        }
    </div>
</div>

<div class="card-fold card">
    <div class="card-body p-0">
        <table class="table table-fold mb-0">
            <thead><tr><th style="width:60px">Mã</th><th>Tên ca</th><th>Giờ bắt đầu</th><th>Giờ kết thúc</th><th>Thời lượng</th><th>Lượt dùng</th><th class="text-end">Thao tác</th></tr></thead>
            <tbody>
                @foreach (var c in Model)
                {
                    var quaDem = QuanLyCuaHangTheThao.Services.LichLamViecTinh.LaCaQuaDem(c.DGioBatDau, c.DGioKetThuc);
                    <tr>
                        <td><span class="badge-fold badge-mute">#@c.IMaCa</span></td>
                        <td class="fw-medium">@c.STenCa</td>
                        <td>@QuanLyCuaHangTheThao.Services.LichLamViecTinh.FormatGio(c.DGioBatDau)</td>
                        <td>@QuanLyCuaHangTheThao.Services.LichLamViecTinh.FormatGio(c.DGioKetThuc)</td>
                        <td>
                            <span class="badge-fold badge-accent">@QuanLyCuaHangTheThao.Services.LichLamViecTinh.SoGioCa(c.DGioBatDau, c.DGioKetThuc) h</span>
                            @if (quaDem)
                            {
                                <span class="badge-fold badge-mute">qua đêm</span>
                            }
                        </td>
                        <td class="text-secondary">@c.TblLichLamViecs.Count lượt</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-accent" asp-action="Edit" asp-route-id="@c.IMaCa">Sửa</a>
                            <form asp-action="Delete" asp-route-id="@c.IMaCa" method="post" class="d-inline" onsubmit="return confirm('Xóa ca @c.STenCa?');">
                                <button class="btn btn-sm btn-outline-danger" type="submit">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7"><div class="empty-state"><div class="empty-icon">🕐</div><div>Chưa có ca làm việc nào. Hãy thêm ca đầu tiên.</div></div></td></tr>
                }
            </tbody>
        </table>
    </div>
</div>