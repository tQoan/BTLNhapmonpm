@model QuanLyCuaHangTheThao.Models.Scaffold.TblVaiTro
@{ ViewData["Title"] = "Sửa vai trò"; }
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card-fold card">
            <div class="card-header">Sửa vai trò</div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="IMaVaiTro" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="STenVaiTro" class="form-label">Tên vai trò</label>
                        <input asp-for="STenVaiTro" class="form-control form-control-fold" />
                        <span asp-validation-for="STenVaiTro" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-light px-4">Lưu</button>
                    <a class="btn btn-outline-light" asp-action="Index">Hủy</a>
                </form>
            </div>
        </div>
    </div>
</div>
