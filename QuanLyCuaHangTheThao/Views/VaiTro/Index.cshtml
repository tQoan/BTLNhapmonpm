@model IEnumerable<QuanLyCuaHangTheThao.Models.Scaffold.TblVaiTro>
@{
    ViewData["Title"] = "Vai trò";
}
<div class="page-head">
    <div>
        <h1 class="page-title">Vai trò</h1>
        <div class="page-subtitle">Quản lý vai trò người dùng trong hệ thống</div>
    </div>
    <a class="btn btn-accent" asp-action="Create">+ Thêm vai trò</a>
</div>
@if (TempData["Success"] != null) { <div class="alert alert-success py-2">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger py-2">@TempData["Error"]</div> }

<div class="stat-strip">
    <div class="stat-card">
        <div class="stat-label">Tổng vai trò</div>
        <div class="stat-value">@ViewBag.TongVaiTro</div>
        <div class="stat-caption">vai trò</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Tổng nhân viên</div>
        <div class="stat-value">@ViewBag.TongNhanVien</div>
        <div class="stat-caption">đang sử dụng</div>
    </div>
</div>

<div class="toolbar">
    <form method="get" class="toolbar-search">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" class="form-control form-control-fold" name="search" value="@ViewBag.Search" placeholder="Tìm tên vai trò..." />
    </form>
    <div class="pagination-info">
        @if (!string.IsNullOrWhiteSpace((string?)ViewBag.Search))
        {
            <span>Kết quả cho "<strong>@ViewBag.Search</strong>"</span>
        }
    </div>
</div>

<div class="card-fold card">
    <div class="card-body p-0">
        <table class="table table-fold mb-0">
            <thead><tr><th style="width:60px">Mã</th><th>Tên vai trò</th><th>Nhân viên</th><th class="text-end">Thao tác</th></tr></thead>
            <tbody>
                @foreach (var v in Model)
                {
                    <tr>
                        <td><span class="badge-fold badge-mute">#@v.IMaVaiTro</span></td>
                        <td class="fw-medium">@v.STenVaiTro</td>
                        <td class="text-secondary">@v.TblNhanViens.Count nhân viên</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-accent" asp-action="Edit" asp-route-id="@v.IMaVaiTro">Sửa</a>
                            <form asp-action="Delete" asp-route-id="@v.IMaVaiTro" method="post" class="d-inline" onsubmit="return confirm('Xóa vai trò @v.STenVaiTro?');">
                                <button class="btn btn-sm btn-outline-danger" type="submit">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="4"><div class="empty-state"><div class="empty-icon">👥</div><div>Không tìm thấy vai trò nào.</div></div></td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
