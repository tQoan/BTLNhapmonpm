@model IEnumerable<QuanLyCuaHangTheThao.Models.Scaffold.TblMauSac>
@{
    ViewData["Title"] = "Màu sắc";
}
<div class="page-head">
    <div>
        <h1 class="page-title">Màu sắc</h1>
        <div class="page-subtitle">Quản lý các màu sản phẩm</div>
    </div>
    <a class="btn btn-accent" asp-action="Create">+ Thêm màu</a>
</div>
@if (TempData["Success"] != null) { <div class="alert alert-success py-2">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger py-2">@TempData["Error"]</div> }

<div class="stat-strip">
    <div class="stat-card">
        <div class="stat-label">Tổng màu</div>
        <div class="stat-value">@ViewBag.TongMau</div>
        <div class="stat-caption">màu sắc</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Sản phẩm liên kết</div>
        <div class="stat-value">@ViewBag.TongSanPham</div>
        <div class="stat-caption">từ các màu</div>
    </div>
</div>

<div class="toolbar">
    <form method="get" class="toolbar-search">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" class="form-control form-control-fold" name="search" value="@ViewBag.Search" placeholder="Tìm tên màu..." />
    </form>
    <div class="pagination-info">
        @if (!string.IsNullOrWhiteSpace((string?)ViewBag.Search))
        {
            <span>Kết quả cho "<strong>@ViewBag.Search</strong>"</span>
        }
    </div>
</div>

<div class="card-fold card">
    <div class="card-body p-0">
        <table class="table table-fold mb-0">
            <thead><tr><th style="width:60px">Mã</th><th>Tên màu</th><th>Sản phẩm sử dụng</th><th class="text-end">Thao tác</th></tr></thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td><span class="badge-fold badge-mute">#@m.IMaMau</span></td>
                        <td class="fw-medium">@m.STenMau</td>
                        <td class="text-secondary">@m.TblSanPhamTblMauSacs.Count sản phẩm</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-accent" asp-action="Edit" asp-route-id="@m.IMaMau">Sửa</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <form asp-action="Delete" asp-route-id="@m.IMaMau" method="post" class="d-inline" onsubmit="return confirm('Xóa màu @m.STenMau?');">
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Xóa</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="4"><div class="empty-state"><div class="empty-icon">🎨</div><div>Không tìm thấy màu nào.</div></div></td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
