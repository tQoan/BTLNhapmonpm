@model IEnumerable<QuanLyCuaHangTheThao.Models.Scaffold.TblLichLamViec>
@using QuanLyCuaHangTheThao.Services
@{
    ViewData["Title"] = "Lịch của tôi";
    var danhSach = Model.ToList();
}
<div class="page-head">
    <div>
        <h1 class="page-title">Lịch của tôi</h1>
        <div class="page-subtitle">Các ca sắp tới của @ViewBag.TenNv trong 14 ngày tới</div>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a class="btn btn-outline-light" asp-action="Index">Lịch phân công</a>
    }
</div>

@if (!danhSach.Any())
{
    <div class="card-fold card">
        <div class="card-body">
            <div class="empty-state">
                <div class="empty-icon">🗓️</div>
                <div>Bạn chưa được phân ca nào từ @DateTime.Today.ToString("dd/MM/yyyy") đến @(((DateTime)ViewBag.DenNgay).ToString("dd/MM/yyyy")).</div>
            </div>
        </div>
    </div>
}
else
{
    var homNay = DateTime.Today;
    <div class="card-fold card">
        <div class="card-body p-0">
            <table class="table table-fold mb-0">
                <thead><tr><th style="width:150px">Ngày</th><th>Thứ</th><th>Ca</th><th>Giờ</th><th>Thời lượng</th><th>Ghi chú</th></tr></thead>
                <tbody>
                    @foreach (var l in danhSach)
                    {
                        var ca = l.IMaCaNavigation;
                        var homNayLa = l.DNgayLam == homNay;
                        <tr class="@(homNayLa ? "table-active" : "")">
                            <td><span class="badge-fold @(homNayLa ? "badge-accent" : "badge-mute")">@l.DNgayLam.ToString("dd/MM/yyyy")</span></td>
                            <td>@LichLamViecTinh.TenThuTrongTuan((l.DNgayLam - LichLamViecTinh.DauTuan(l.DNgayLam)).Days)</td>
                            <td class="fw-medium">@ca?.STenCa</td>
                            <td>
                                @if (ca != null)
                                {
                                    <span>@LichLamViecTinh.FormatGio(ca.DGioBatDau)</span>
                                    <span class="text-secondary">→</span>
                                    <span>@LichLamViecTinh.FormatGio(ca.DGioKetThuc)</span>
                                    if (LichLamViecTinh.LaCaQuaDem(ca.DGioBatDau, ca.DGioKetThuc))
                                    {
                                        <span class="badge-fold badge-mute">+1 ngày</span>
                                    }
                                }
                            </td>
                            <td>@if (ca != null) { <span>@LichLamViecTinh.SoGioCa(ca.DGioBatDau, ca.DGioKetThuc) h</span> }</td>
                            <td class="text-secondary">@(string.IsNullOrWhiteSpace(l.SGhiChu) ? "—" : l.SGhiChu)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="stat-strip mt-3">
        <div class="stat-card">
            <div class="stat-label">Số ca sắp tới</div>
            <div class="stat-value">@danhSach.Count</div>
            <div class="stat-caption">trong 14 ngày</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Tổng giờ</div>
            <div class="stat-value">@Math.Round(danhSach.Sum(l => l.IMaCaNavigation == null ? 0 : LichLamViecTinh.SoGioCa(l.IMaCaNavigation.DGioBatDau, l.IMaCaNavigation.DGioKetThuc)), 1)</div>
            <div class="stat-caption">giờ</div>
        </div>
    </div>
}