@model QuanLyCuaHangTheThao.Models.Scaffold.TblKichThuoc
@{ ViewData["Title"] = "Sửa size"; }
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card-fold card">
            <div class="card-header">Sửa kích thước</div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="IMaSize" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="STenSize" class="form-label">Tên size</label>
                        <input asp-for="STenSize" class="form-control form-control-fold" />
                        <span asp-validation-for="STenSize" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-light px-4">Lưu</button>
                    <a class="btn btn-outline-light" asp-action="Index">Hủy</a>
                </form>
            </div>
        </div>
    </div>
</div>
