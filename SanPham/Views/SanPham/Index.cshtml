@model QuanLyCuaHangTheThao.PaginatedList<QuanLyCuaHangTheThao.Models.Scaffold.TblSanPham>
@{
    ViewData["Title"] = "Sản phẩm";
}
<div class="page-head">
    <div>
        <h1 class="page-title">Sản phẩm</h1>
        <div class="page-subtitle">Quản lý danh mục sản phẩm đồ thể thao của cửa hàng</div>
    </div>
    <a class="btn btn-accent" asp-action="Create">+ Thêm sản phẩm</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success py-2">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2">@TempData["Error"]</div>
}

<div class="stat-strip">
    <div class="stat-card">
        <div class="stat-label">Tổng sản phẩm</div>
        <div class="stat-value">@ViewBag.TongSanPham</div>
        <div class="stat-caption">đang theo dõi</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Tổng tồn kho</div>
        <div class="stat-value">@ViewBag.TongTonKho</div>
        <div class="stat-caption">đơn vị sản phẩm</div>
    </div>
    <div class="stat-card">
        <div class="stat-label ">Giá trị tồn (giá nhập)</div>
        <div class="stat-value accent">@ViewBag.TongGiaTriTon.ToString("#,##0") <small style="font-size:.8rem">đ</small></div>
        <div class="stat-caption">theo giá nhập</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Giá trị bán tối đa</div>
        <div class="stat-value">@ViewBag.TongGiaTriBan.ToString("#,##0") <small style="font-size:.8rem">đ</small></div>
        <div class="stat-caption">theo giá bán</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Hết hàng</div>
        <div class="stat-value" style="color:@(ViewBag.HetHang > 0 ? "var(--warning)" : "var(--success)")">@ViewBag.HetHang</div>
        <div class="stat-caption">sản phẩm tồn = 0</div>
    </div>
</div>

<div class="toolbar">
    <form method="get" class="toolbar-search">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" class="form-control form-control-fold" name="search" value="@ViewBag.Search" placeholder="Tìm sản phẩm, nhà cung cấp..." />
    </form>
    <div class="pagination-info">
        @if (!string.IsNullOrWhiteSpace((string?)ViewBag.Search))
        {
            <span>Kết quả cho "<strong>@ViewBag.Search</strong>"</span>
        }
    </div>
</div>

<div class="card-fold card">
    <div class="card-body p-0">
        <table class="table table-fold mb-0">
            <thead>
                <tr>
                    <th style="width:60px">Mã</th>
                    <th style="width:64px">Ảnh</th>
                    <th>Tên sản phẩm</th>
                    <th>Nhà cung cấp</th>
                    <th class="text-end">Giá nhập</th>
                    <th class="text-end">Giá bán</th>
                    <th class="text-center">Tồn kho</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sp in Model)
                {
                    <tr>
                        <td><span class="badge-fold badge-mute">#@sp.IMaSp</span></td>
                        <td>
                            @{
                                var img = QuanLyCuaHangTheThao.Controllers.SanPhamController.GetImageUrl(sp.IMaSp);
                            }
                            @if (!string.IsNullOrEmpty(img))
                            {
                                <img src="@img" style="width:44px;height:44px;border-radius:6px;object-fit:cover;" />
                            }
                            else
                            {
                                <span class="text-secondary" style="font-size:.75rem">—</span>
                            }
                        </td>
                        <td class="fw-medium">@sp.STenSp</td>
                        <td>@sp.IMaNccNavigation?.STenNcc</td>
                        <td class="text-end text-secondary">@sp.FGiaNhap.ToString("#,##0") đ</td>
                        <td class="text-end">@sp.FGiaBan.ToString("#,##0") đ</td>
                        <td class="text-center">
                            @if (sp.ISoLuongTon == 0)
                            {
                                <span class="badge-fold badge-danger">@sp.ISoLuongTon</span>
                            }
                            else if (sp.ISoLuongTon <= 5)
                            {
                                <span class="badge-fold badge-warn">@sp.ISoLuongTon</span>
                            }
                            else
                            {
                                <span class="badge-fold badge-ok">@sp.ISoLuongTon</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-accent" asp-action="Edit" asp-route-id="@sp.IMaSp">Sửa</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <form asp-action="Delete" asp-route-id="@sp.IMaSp" method="post" class="d-inline"
                                      onsubmit="return confirm('Xóa sản phẩm @sp.STenSp?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8">
                            <div class="empty-state">
                                <div class="empty-icon">📦</div>
                                <div>Không tìm thấy sản phẩm nào.</div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="Pager" model="Model" />
