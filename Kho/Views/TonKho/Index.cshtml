@model QuanLyCuaHangTheThao.PaginatedList<QuanLyCuaHangTheThao.Models.Scaffold.VTonKho>
@{
    ViewData["Title"] = "Tồn kho";
}
<div class="page-head">
    <div>
        <h1 class="page-title">Tồn kho theo biến thể</h1>
        <div class="page-subtitle">Số lượng nhập, bán và tồn của từng size / màu</div>
    </div>
    <a class="btn btn-outline-accent" asp-action="HanDung">Theo hạn dùng</a>
</div>

<div class="stat-strip">
    <div class="stat-card">
        <div class="stat-label">Mặt hàng biến thể</div>
        <div class="stat-value">@ViewBag.TongMatHang</div>
        <div class="stat-caption">size × màu</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Tổng tồn kho</div>
        <div class="stat-value accent">@ViewBag.TongTon</div>
        <div class="stat-caption">đơn vị hiện có</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Tổng đã nhập</div>
        <div class="stat-value">@ViewBag.TongNhap</div>
        <div class="stat-caption">đơn vị qua các phiếu nhập</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Sắp hết (≤ 5)</div>
        <div class="stat-value" style="color:@(ViewBag.SapHet > 0 ? "var(--warning)" : "var(--success)")">@ViewBag.SapHet</div>
        <div class="stat-caption">cần nhập thêm</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Hết hàng</div>
        <div class="stat-value" style="color:@(ViewBag.HetHang > 0 ? "var(--danger)" : "var(--success)")">@ViewBag.HetHang</div>
        <div class="stat-caption">tồn = 0</div>
    </div>
</div>

<div class="toolbar">
    <form method="get" class="toolbar-search">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" class="form-control form-control-fold" name="search" value="@ViewBag.Search" placeholder="Tìm sản phẩm, size, màu..." />
    </form>
    <div class="pagination-info">
        @if (!string.IsNullOrWhiteSpace((string?)ViewBag.Search))
        {
            <span>Kết quả cho "<strong>@ViewBag.Search</strong>"</span>
        }
    </div>
</div>

<div class="card-fold card">
    <div class="card-body p-0">
        <table class="table table-fold mb-0">
            <thead><tr><th>Sản phẩm</th><th>Kích thước</th><th>Màu sắc</th><th class="text-end">Đã nhập</th><th class="text-end">Đã bán</th><th class="text-center">Tồn kho</th></tr></thead>
            <tbody>
                @foreach (var tk in Model)
                {
                    <tr>
                        <td class="fw-medium">@tk.STenSp</td>
                        <td>@tk.STenSize</td>
                        <td>@tk.STenMau</td>
                        <td class="text-end text-secondary">@tk.FTongNhap</td>
                        <td class="text-end text-secondary">@tk.FTongBan</td>
                        <td class="text-center">
                            @if ((tk.ISoLuongTon ?? 0) == 0)
                            {
                                <span class="badge-fold badge-danger">@tk.ISoLuongTon</span>
                            }
                            else if ((tk.ISoLuongTon ?? 0) <= 5)
                            {
                                <span class="badge-fold badge-warn">@tk.ISoLuongTon</span>
                            }
                            else
                            {
                                <span class="badge-fold badge-ok">@tk.ISoLuongTon</span>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="6"><div class="empty-state"><div class="empty-icon">📦</div><div>Không có dữ liệu tồn kho.</div></div></td></tr> }
            </tbody>
        </table>
    </div>
</div>

<partial name="Pager" model="Model" />
